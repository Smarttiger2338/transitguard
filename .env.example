# TAGO 공공데이터 API 서비스 키입니다. 실제 키는 Git에 올리지 마세요.
TAGO_SERVICE_KEY=

# 브라우저 데모의 TAGO 실시간 도착정보 모드에서 사용할 수 있는 선택 기본값입니다.
# cityCode는 TAGO 도시코드 데이터, nodeId는 TAGO 정류소 데이터에서 확인합니다.
TAGO_CITY_CODE=
TAGO_NODE_ID=
TAGO_ORIGIN_NODE_ID=
TAGO_DESTINATION_NODE_ID=
TAGO_ROUTE_IDS=

# 개발 환경 기본값입니다. 배포 환경에서는 * 대신 허용할 출처를 쉼표로 구분해 입력하세요.
TRANSITGUARD_CORS_ORIGINS=*

# 선택: 자동 검색 대신 하나의 env 파일을 명시적으로 사용합니다.
# TRANSITGUARD_ENV_FILE=/absolute/path/to/.env

# 선택: Kakao 지도 JavaScript API의 공개 브라우저 키입니다.
# Kakao Developers 웹 플랫폼에 http://127.0.0.1:8080을 등록하세요.
KAKAO_MAP_JAVASCRIPT_KEY=

