# Public data API key. Keep real keys out of git.
TAGO_SERVICE_KEY=

# Optional values for the browser demo's TAGO live-arrival mode.
# cityCode comes from TAGO city-code data, and nodeId comes from TAGO bus-stop data.
TAGO_CITY_CODE=
TAGO_NODE_ID=
TAGO_ORIGIN_NODE_ID=
TAGO_DESTINATION_NODE_ID=
TAGO_ROUTE_IDS=

# Development default. For deployment, replace * with a comma-separated allowlist.
TRANSITGUARD_CORS_ORIGINS=*

# Optional: use one explicit env file instead of automatic local lookup.
# TRANSITGUARD_ENV_FILE=/absolute/path/to/.env

# Optional public browser key for Kakao Map JavaScript API.
# Register http://127.0.0.1:8080 in Kakao Developers > Web platform.
KAKAO_MAP_JAVASCRIPT_KEY=
